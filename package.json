{
  "name": "seraphim-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens:build": "node tokens/scripts/build-tokens.ts",
    "tokens:check": "node tokens/scripts/build-tokens.ts --check",
    "tokens:version": "node tokens/scripts/check-version.ts",
    "lint:tokens": "node tokens/scripts/check-tokens.ts src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:ts6": "npx --yes -p typescript@6.0.3 tsc -p tsconfig.json",
    "ci": "node scripts/gate.ts",
    "ci:rapido": "node scripts/gate.ts --no-browser",
    "ci:navegador": "node scripts/gate.ts --browser",
    "health": "node scripts/health.ts",
    "prepare": "node scripts/install-hooks.ts",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.ts\"",
    "test:browser:firefox": "node scripts/test-browser.ts firefox",
    "test:browser:webkit": "node scripts/test-browser.ts webkit",
    "test:browser:todos": "node scripts/test-browser.ts todos",
    "lint:html": "node tokens/scripts/check-html.ts src"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@types/node": "24.19.1",
    "axe-core": "4.10.2",
    "playwright": "1.56.0",
    "stylelint": "17.16.0",
    "typescript": "7.0.2"
  }
}
